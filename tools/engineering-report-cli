#!/bin/bash
# engineering-report: Open engineering report in browser with auto-regeneration
# Usage: engineering-report [serve|open]

SOURCE="$0"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
AI_TOOLING_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPORT_DIR="$AI_TOOLING_DIR/tools/engineering-report"

case "${1:-serve}" in
    serve)
        cd "$REPORT_DIR" && make serve
        ;;
    open)
        cd "$REPORT_DIR" && make open
        ;;
    help|--help|-h)
        echo "Usage: engineering-report [serve|open]"
        echo "  serve - Start local server with auto-regeneration (default)"
        echo "  open  - Just open the latest report in browser"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Usage: engineering-report [serve|open]"
        exit 1
        ;;
esac
